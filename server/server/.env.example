# Backend configuration — copy to .env and replace values for your environment.
NODE_ENV=development
PORT=3001
MONGODB_URI=mongodb://127.0.0.1:27017/platform_registration_management
CLIENT_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
BCRYPT_ROUNDS=12

# Production:
# NODE_ENV=production
# CLIENT_ORIGINS=https://your-frontend.example
# COOKIE_SECURE=true
